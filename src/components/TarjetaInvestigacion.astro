---
import type { CollectionEntry } from 'astro:content';
import { t, type Idioma } from '../i18n/ui';

interface Props {
	entrada: CollectionEntry<'investigacion'> | CollectionEntry<'publicaciones'>;
	idioma: Idioma;
}

const { entrada, idioma } = Astro.props;
const textos = t(idioma);
const { titulo, resumen, tipo, rol, venue, anio, doi, url, estado, etiquetas, origen } = entrada.data;
const slug = entrada.id.replace(/^(es|en)\//, '');

const enlace = doi ? `https://doi.org/${doi}` : url;
const esExterno = origen === 'orcid';
const destinoTitulo = esExterno ? enlace : `/${idioma}/investigacion/${slug}/`;
---

<article class="group relative flex flex-col overflow-hidden rounded-2xl border border-tinta-200 bg-white transition-colors hover:border-arena dark:border-tinta-800 dark:bg-tinta-900">
	<div class="flex h-40 flex-col justify-between bg-tinta-900 p-5 text-tinta-50 dark:bg-tinta-800">
		<div class="flex items-center justify-between text-xs tracking-wide uppercase">
			<span>{textos.tipos[tipo]}</span>
			<span>{anio}</span>
		</div>
		<p class="line-clamp-2 text-2xl font-semibold text-arena">{venue ?? rol}</p>
	</div>

	<div class="flex flex-1 flex-col p-6">
		{
			estado !== 'publicado' && (
				<span class="w-fit rounded-full bg-arena/20 px-2 py-0.5 text-xs text-tinta-900 ring-1 ring-arena/40 ring-inset dark:text-arena">
					{textos.estados[estado]}
				</span>
			)
		}

		<h3 class="mt-3 text-xl font-semibold leading-snug text-tinta-900 dark:text-tinta-50">
			{
				destinoTitulo ? (
					<a
						href={destinoTitulo}
						class="after:absolute after:inset-0 hover:text-arena"
						rel={esExterno ? 'noopener' : undefined}
						target={esExterno ? '_blank' : undefined}
					>
						{titulo}
					</a>
				) : (
					titulo
				)
			}
		</h3>

		<p class="mt-1 text-sm text-tinta-600 dark:text-tinta-300">{rol}</p>
		<p class:list={['mt-3 text-sm leading-relaxed', esExterno ? 'text-tinta-600 dark:text-tinta-300' : 'text-tinta-600 dark:text-tinta-300']}>{resumen}</p>

		{
			etiquetas.length > 0 && (
				<ul class="mt-4 flex flex-wrap gap-1.5" aria-label={textos.etiquetas.tecnologias}>
					{etiquetas.map((etiqueta) => (
						<li class="rounded bg-tinta-50 px-2 py-0.5 text-xs text-tinta-600 dark:bg-tinta-800 dark:text-tinta-300">
							{etiqueta}
						</li>
					))}
				</ul>
			)
		}

		{
			enlace && (
				<div class="mt-auto pt-5 text-sm">
					<a href={enlace} rel="noopener" target="_blank" class="relative z-10 font-medium text-ocre hover:underline dark:text-arena">
						{doi ? `DOI: ${doi}` : textos.investigacion.publicacion}
					</a>
				</div>
			)
		}
	</div>
</article>
