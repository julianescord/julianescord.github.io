---
import type { CollectionEntry } from 'astro:content';
import { t, type Idioma } from '../i18n/ui';

interface Props {
	entrada: CollectionEntry<'software'>;
	idioma: Idioma;
}

const { entrada, idioma } = Astro.props;
const textos = t(idioma);
const { titulo, resumen, stack, estado, anio, repo, demo, sitio, privado } = entrada.data;
const slug = entrada.id.replace(/^(es|en)\//, '');
---

<article class="group relative flex flex-col overflow-hidden rounded-2xl border border-tinta-200 bg-white transition-colors hover:border-menta dark:border-tinta-800 dark:bg-tinta-900">
	<div class="flex h-40 flex-col justify-between bg-acento-500 p-5 text-white dark:bg-tinta-800">
		<div class="flex items-center justify-between text-xs tracking-wide uppercase">
			<span>{textos.nav.software}</span>
			<span>{anio}</span>
		</div>
		<p class="text-3xl font-semibold text-menta">{stack[0]}</p>
	</div>

	<div class="flex flex-1 flex-col p-6">
		<div class="flex flex-wrap items-center gap-3 text-xs text-tinta-600 dark:text-tinta-300">
			<span class="rounded-full bg-tinta-50 px-2 py-0.5 ring-1 ring-tinta-200 ring-inset dark:bg-tinta-800 dark:ring-tinta-600">
				{textos.estados[estado]}
			</span>
		</div>

		<h3 class="mt-3 text-2xl font-semibold text-tinta-900 dark:text-tinta-50">
			<a href={`/${idioma}/software/${slug}/`} class="after:absolute after:inset-0 hover:text-menta">
				{titulo}
			</a>
		</h3>

		<p class="mt-3 text-sm leading-relaxed text-tinta-600 dark:text-tinta-300">{resumen}</p>

		<ul class="mt-4 flex flex-wrap gap-1.5" aria-label={textos.etiquetas.tecnologias}>
			{
				stack.map((tecnologia) => (
					<li class="rounded bg-tinta-50 px-2 py-0.5 text-xs text-tinta-600 dark:bg-tinta-800 dark:text-tinta-300">
						{tecnologia}
					</li>
				))
			}
		</ul>

		<div class="mt-auto flex flex-wrap items-center gap-4 pt-5 text-sm">
			{demo && <a href={demo} class="relative z-10 font-medium text-acento-500 hover:underline dark:text-menta">{textos.proyectos.demo} →</a>}
			{sitio && <a href={sitio} rel="noopener" target="_blank" class="relative z-10 font-medium text-acento-500 hover:underline dark:text-menta">{textos.proyectos.sitio} →</a>}
			{repo && <a href={repo} rel="noopener" target="_blank" class="relative z-10 text-tinta-600 hover:text-acento-500 dark:text-tinta-300 dark:hover:text-menta">{textos.proyectos.repo}</a>}
			{privado && !repo && <span class="text-tinta-600 dark:text-tinta-300">{textos.proyectos.privado}</span>}
		</div>
	</div>
</article>
