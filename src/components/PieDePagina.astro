---
const anio = new Date().getFullYear();
---

<footer class="border-t border-tinta-200 dark:border-tinta-800">
	<div
		class="mx-auto flex max-w-3xl flex-col gap-3 px-4 py-8 text-sm text-tinta-600 sm:flex-row sm:items-center sm:px-6 dark:text-tinta-400"
	>
		<p>© {anio} Julián E. Ordoñez</p>

		<nav class="flex gap-4 sm:ml-auto" aria-label="Enlaces externos">
			<a
				href="https://github.com/julianescord"
				class="hover:text-acento-500"
				rel="me noopener"
				target="_blank">GitHub</a
			>
			<a
				href="https://www.linkedin.com/in/julianescord"
				class="hover:text-acento-500"
				rel="me noopener"
				target="_blank">LinkedIn</a
			>
		</nav>
	</div>
</footer>
