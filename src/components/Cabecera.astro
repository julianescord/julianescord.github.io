---
const rutaActual = Astro.url.pathname;

const enlaces = [
	{ href: '/', texto: 'Inicio' },
	{ href: '/software/', texto: 'Software' },
	{ href: '/investigacion/', texto: 'Investigación' },
];

// Marca "Software" como activo tanto en el indice como en cada ficha.
const esActivo = (href: string) =>
	href === '/' ? rutaActual === '/' : rutaActual.startsWith(href);
---

<header
	class="sticky top-0 z-40 border-b border-tinta-200 bg-white/85 backdrop-blur dark:border-tinta-800 dark:bg-tinta-950/85"
>
	<div class="mx-auto flex max-w-3xl items-center gap-4 px-4 py-3 sm:px-6">
		<a
			href="/"
			class="font-semibold tracking-tight text-tinta-900 hover:text-acento-500 dark:text-tinta-50"
		>
			Julián E. Ordoñez
		</a>

		<nav class="ml-auto flex items-center gap-1" aria-label="Principal">
			{
				enlaces.slice(1).map((enlace) => (
					<a
						href={enlace.href}
						aria-current={esActivo(enlace.href) ? 'page' : undefined}
						class:list={[
							'rounded-md px-3 py-1.5 text-sm transition-colors',
							esActivo(enlace.href)
								? 'bg-tinta-50 font-medium text-tinta-900 dark:bg-tinta-800 dark:text-tinta-50'
								: 'text-tinta-600 hover:text-tinta-900 dark:text-tinta-400 dark:hover:text-tinta-50',
						]}
					>
						{enlace.texto}
					</a>
				))
			}

			<button
				id="alternar-tema"
				type="button"
				aria-label="Cambiar entre tema claro y oscuro"
				class="ml-1 rounded-md p-2 text-tinta-600 hover:bg-tinta-50 hover:text-tinta-900 dark:text-tinta-400 dark:hover:bg-tinta-800 dark:hover:text-tinta-50"
			>
				<svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" />
				</svg>
				<svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<circle cx="12" cy="12" r="4" />
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
				</svg>
			</button>
		</nav>
	</div>
</header>

<script>
	const boton = document.getElementById('alternar-tema');

	boton?.addEventListener('click', () => {
		const oscuro = document.documentElement.classList.toggle('dark');
		try {
			localStorage.setItem('tema', oscuro ? 'oscuro' : 'claro');
		} catch {
			/* Si no se puede guardar, el cambio vale solo para esta pagina. */
		}
	});
</script>
