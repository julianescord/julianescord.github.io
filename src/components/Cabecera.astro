---
import { idiomas, t, type Idioma } from '../i18n/ui';

interface Props {
	idioma: Idioma;
	rutaAlterna: string;
}

const { idioma, rutaAlterna } = Astro.props;
const textos = t(idioma);

const secciones = [
	{ id: 'proyectos', texto: textos.nav.proyectos },
	{ id: 'habilidades', texto: textos.nav.habilidades },
	{ id: 'sobre-mi', texto: textos.nav.sobreMi },
	{ id: 'contacto', texto: textos.nav.contacto },
];

const enlaceClase =
	'text-sm text-tinta-600 transition-colors hover:text-tinta-900 aria-[current=true]:font-medium aria-[current=true]:text-tinta-900 aria-[current=true]:underline aria-[current=true]:decoration-acento-500 aria-[current=true]:underline-offset-8 dark:text-tinta-300 dark:hover:text-tinta-50 dark:aria-[current=true]:text-tinta-50 dark:aria-[current=true]:decoration-menta';
---

<header class="sticky top-0 z-40 border-b border-tinta-200 bg-papel/95 backdrop-blur dark:border-tinta-800 dark:bg-tinta-950/95">
	<div class="mx-auto flex max-w-6xl items-center gap-6 px-5 py-4 sm:px-8">
		<a href={`/${idioma}/`} class="flex items-center gap-3">
			<span class="flex size-10 items-center justify-center rounded-full bg-acento-500 text-sm font-semibold text-white dark:bg-menta dark:text-tinta-950">
				JO
			</span>
			<span class="leading-tight">
				<span class="block font-semibold text-tinta-900 dark:text-tinta-50">{textos.nombre}</span>
				<span class="block text-xs tracking-wide text-tinta-600 uppercase dark:text-tinta-300">Nanobio · IA · Materiales</span>
			</span>
		</a>

		<nav class="ml-auto hidden items-center gap-7 md:flex" aria-label={textos.nav.inicio}>
			{
				secciones.map((seccion) => (
					<a href={`/${idioma}/#${seccion.id}`} data-spy={seccion.id} class={enlaceClase}>
						{seccion.texto}
					</a>
				))
			}
		</nav>

		<div class="ml-auto flex items-center gap-3 md:ml-0">
			<details class="group relative">
				<summary
					class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-tinta-200 px-3 py-1.5 text-sm text-tinta-900 dark:border-tinta-800 dark:text-tinta-50"
					aria-label={idioma === 'es' ? 'Idioma' : 'Language'}
				>
					{idioma.toUpperCase()}
					<svg class="size-3 transition-transform group-open:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
						<path d="M2 4l4 4 4-4" />
					</svg>
				</summary>
				<ul class="absolute right-0 mt-2 w-max overflow-hidden rounded-lg border border-tinta-200 bg-papel py-1 shadow-lg dark:border-tinta-800 dark:bg-tinta-900">
					{
						idiomas.map((lang) => (
							<li>
								<a
									href={lang === idioma ? `/${lang}/` : rutaAlterna}
									hreflang={lang}
									aria-current={lang === idioma ? 'true' : undefined}
									class="block px-4 py-2 whitespace-nowrap text-sm text-tinta-900 hover:bg-tinta-50 aria-[current=true]:font-medium aria-[current=true]:text-acento-500 dark:text-tinta-50 dark:hover:bg-tinta-800 dark:aria-[current=true]:text-menta"
								>
									{lang === 'es' ? 'Español' : 'English'}
								</a>
							</li>
						))
					}
				</ul>
			</details>

			<button
				id="alternar-tema"
				type="button"
				aria-label={textos.temaCambio}
				class="rounded-full border border-tinta-200 p-2 text-tinta-600 hover:text-tinta-900 dark:border-tinta-800 dark:text-tinta-300 dark:hover:text-tinta-50"
			>
				<svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" />
				</svg>
				<svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<circle cx="12" cy="12" r="4" />
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
				</svg>
			</button>

			<details class="group relative md:hidden">
				<summary class="cursor-pointer list-none rounded-full border border-tinta-200 px-3 py-1.5 text-sm text-tinta-900 dark:border-tinta-800 dark:text-tinta-50">
					{idioma === 'es' ? 'Menú' : 'Menu'}
				</summary>
				<nav class="absolute right-0 mt-2 flex w-56 flex-col gap-1 rounded-lg border border-tinta-200 bg-papel p-2 shadow-lg dark:border-tinta-800 dark:bg-tinta-900" aria-label={textos.nav.inicio}>
					{
						secciones.map((seccion) => (
							<a href={`/${idioma}/#${seccion.id}`} class="rounded px-3 py-2 text-tinta-900 hover:bg-tinta-50 dark:text-tinta-50 dark:hover:bg-tinta-800">
								{seccion.texto}
							</a>
						))
					}
				</nav>
			</details>
		</div>
	</div>
</header>

<script>
	const boton = document.getElementById('alternar-tema');

	boton?.addEventListener('click', () => {
		const oscuro = document.documentElement.classList.toggle('dark');
		try {
			localStorage.setItem('tema', oscuro ? 'oscuro' : 'claro');
		} catch {
			/* Si no se puede guardar, el cambio vale solo para esta pagina. */
		}
	});

	const enlaces = document.querySelectorAll<HTMLAnchorElement>('[data-spy]');
	const marcar = (id: string) =>
		enlaces.forEach((enlace) => {
			if (enlace.dataset.spy === id) enlace.setAttribute('aria-current', 'true');
			else enlace.removeAttribute('aria-current');
		});

	const observador = new IntersectionObserver(
		(entradas) => {
			entradas.forEach((entrada) => {
				if (entrada.isIntersecting) marcar(entrada.target.id);
			});
		},
		{ rootMargin: '-35% 0px -60% 0px' },
	);

	document.querySelectorAll('section[id]').forEach((seccion) => observador.observe(seccion));
</script>
