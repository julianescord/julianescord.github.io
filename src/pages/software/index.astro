---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TarjetaSoftware from '../../components/TarjetaSoftware.astro';

const proyectos = (await getCollection('software')).sort(
	(a, b) => a.data.orden - b.data.orden || b.data.anio - a.data.anio,
);
---

<Base
	titulo="Software"
	descripcion="Proyectos de software: librerías, infraestructura y herramientas construidas por Julián E. Ordoñez."
>
	<h1 class="text-3xl font-bold tracking-tight text-tinta-900 dark:text-tinta-50">
		Software
	</h1>

	<p class="mt-3 leading-relaxed text-tinta-600 dark:text-tinta-400">
		Librerías, infraestructura y herramientas. Parte del código es privado
		&mdash; en esos casos la ficha describe el proyecto sin enlazar al
		repositorio.
	</p>

	<div class="mt-8 grid gap-4">
		{proyectos.map((entrada) => <TarjetaSoftware entrada={entrada} />)}
	</div>

	{
		proyectos.length === 0 && (
			<p class="mt-8 text-tinta-400">Todavía no hay proyectos publicados.</p>
		)
	}
</Base>
