---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import { t, type Idioma } from '../../../i18n/ui';

export const getStaticPaths = (async () => {
	const proyectos = await getCollection('software');
	return proyectos.map((entrada) => {
		const [lang, ...resto] = entrada.id.split('/');
		return { params: { lang, slug: resto.join('/') }, props: { entrada, lang: lang as Idioma } };
	});
}) satisfies GetStaticPaths;

const { entrada, lang } = Astro.props;
const textos = t(lang);
const { titulo, resumen, stack, estado, anio, repo, demo, sitio, privado } = entrada.data;
const { Content } = await render(entrada);
---

<Base titulo={titulo} descripcion={resumen} idioma={lang}>
	<a href={`/${lang}/#proyectos`} class="text-sm text-acento-500 hover:underline dark:text-acento-400">
		← {textos.nav.proyectos}
	</a>

	<header class="mt-4 border-b border-tinta-200 pb-6 dark:border-tinta-800">
		<h1 class="titulo-display text-4xl leading-tight text-tinta-900 dark:text-tinta-50">{titulo}</h1>

		<p class="mt-3 text-lg leading-relaxed text-tinta-600 dark:text-tinta-300">{resumen}</p>

		<dl class="mt-5 flex flex-wrap gap-x-8 gap-y-3 text-sm">
			<div>
				<dt class="text-tinta-600 dark:text-tinta-300">{textos.etiquetas.estado}</dt>
				<dd class="mt-0.5 text-tinta-900 dark:text-tinta-200">{textos.estados[estado]}</dd>
			</div>
			<div>
				<dt class="text-tinta-600 dark:text-tinta-300">{textos.etiquetas.anio}</dt>
				<dd class="mt-0.5 text-tinta-900 dark:text-tinta-200">{anio}</dd>
			</div>
			<div>
				<dt class="text-tinta-600 dark:text-tinta-300">{textos.etiquetas.tecnologias}</dt>
				<dd class="mt-0.5 text-tinta-900 dark:text-tinta-200">{stack.join(' · ')}</dd>
			</div>
		</dl>

		<div class="mt-5 flex flex-wrap gap-3">
			{
				demo && (
					<a href={demo} class="rounded-md bg-acento-500 px-4 py-2 text-sm font-medium text-white hover:bg-acento-500/90">
						{textos.proyectos.demo}
					</a>
				)
			}
			{
				sitio && (
					<a href={sitio} rel="noopener" target="_blank" class="rounded-md bg-acento-500 px-4 py-2 text-sm font-medium text-white hover:bg-acento-500/90">
						{textos.proyectos.sitio}
					</a>
				)
			}
			{
				repo && (
					<a href={repo} rel="noopener" target="_blank" class="rounded-md border border-tinta-200 px-4 py-2 text-sm font-medium text-tinta-900 hover:border-acento-500 dark:border-tinta-800 dark:text-tinta-200">
						{textos.proyectos.repo}
					</a>
				)
			}
			{
				privado && !repo && (
					<span class="rounded-md border border-tinta-200 px-4 py-2 text-sm text-tinta-600 dark:text-tinta-300 dark:border-tinta-800">
						{textos.proyectos.privado}
					</span>
				)
			}
		</div>
	</header>

	<div class="prose prose-neutral mt-8 max-w-none dark:prose-invert prose-headings:font-semibold prose-a:text-acento-500">
		<Content />
	</div>
</Base>
