---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import { t, type Idioma } from '../../../i18n/ui';

export const getStaticPaths = (async () => {
	const trabajos = await getCollection('investigacion');
	return trabajos.map((entrada) => {
		const [lang, ...resto] = entrada.id.split('/');
		return { params: { lang, slug: resto.join('/') }, props: { entrada, lang: lang as Idioma } };
	});
}) satisfies GetStaticPaths;

const { entrada, lang } = Astro.props;
const textos = t(lang);
const { titulo, resumen, tipo, rol, venue, anio, doi, url, estado, etiquetas } = entrada.data;
const { Content } = await render(entrada);

const enlace = doi ? `https://doi.org/${doi}` : url;
---

<Base titulo={titulo} descripcion={resumen} idioma={lang}>
	<a href={`/${lang}/#proyectos`} class="text-sm text-acento-500 hover:underline dark:text-acento-400">
		← {textos.nav.proyectos}
	</a>

	<header class="mt-4 border-b border-tinta-200 pb-6 dark:border-tinta-800">
		<span class="text-xs font-medium tracking-wide text-acento-500 uppercase dark:text-acento-400">
			{textos.tipos[tipo]}
		</span>

		<h1 class="titulo-display mt-1.5 text-4xl leading-tight text-tinta-900 dark:text-tinta-50">{titulo}</h1>

		{venue && <p class="mt-3 text-lg text-tinta-600 italic dark:text-tinta-300">{venue}</p>}

		<dl class="mt-5 flex flex-wrap gap-x-8 gap-y-3 text-sm">
			<div>
				<dt class="text-tinta-600 dark:text-tinta-300">{textos.etiquetas.rol}</dt>
				<dd class="mt-0.5 text-tinta-900 dark:text-tinta-200">{rol}</dd>
			</div>
			<div>
				<dt class="text-tinta-600 dark:text-tinta-300">{textos.etiquetas.anio}</dt>
				<dd class="mt-0.5 text-tinta-900 dark:text-tinta-200">{anio}</dd>
			</div>
			<div>
				<dt class="text-tinta-600 dark:text-tinta-300">{textos.etiquetas.estado}</dt>
				<dd class="mt-0.5 text-tinta-900 dark:text-tinta-200">{textos.estados[estado]}</dd>
			</div>
		</dl>

		{
			enlace && (
				<div class="mt-5">
					<a href={enlace} rel="noopener" target="_blank" class="rounded-md bg-acento-500 px-4 py-2 text-sm font-medium text-white hover:bg-acento-500/90">
						{doi ? `DOI: ${doi}` : textos.investigacion.publicacion}
					</a>
				</div>
			)
		}

		{
			etiquetas.length > 0 && (
				<ul class="mt-5 flex flex-wrap gap-1.5" aria-label={textos.etiquetas.tecnologias}>
					{etiquetas.map((etiqueta) => (
						<li class="rounded bg-tinta-50 px-2 py-0.5 text-xs text-tinta-600 dark:bg-tinta-800 dark:text-tinta-300">
							{etiqueta}
						</li>
					))}
				</ul>
			)
		}
	</header>

	<div class="prose prose-neutral mt-8 max-w-none dark:prose-invert prose-headings:font-semibold prose-a:text-acento-500">
		<Content />
	</div>
</Base>
