---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TarjetaInvestigacion from '../../components/TarjetaInvestigacion.astro';

const trabajos = (await getCollection('investigacion')).sort(
	(a, b) => a.data.orden - b.data.orden || b.data.anio - a.data.anio,
);
---

<Base
	titulo="Investigación"
	descripcion="Publicaciones, tesis y modelos computacionales en nanobiotecnología y biociencias."
>
	<h1 class="text-3xl font-bold tracking-tight text-tinta-900 dark:text-tinta-50">
		Investigación
	</h1>

	<p class="mt-3 leading-relaxed text-tinta-600 dark:text-tinta-400">
		Publicaciones revisadas por pares, tesis y modelos computacionales en
		nanobiotecnología, liberación controlada y sistemas basados en bacteriófagos.
	</p>

	<div class="mt-8 grid gap-4">
		{trabajos.map((entrada) => <TarjetaInvestigacion entrada={entrada} />)}
	</div>

	{
		trabajos.length === 0 && (
			<p class="mt-8 text-tinta-400">Todavía no hay trabajos publicados.</p>
		)
	}
</Base>
