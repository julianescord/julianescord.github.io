---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TarjetaInvestigacion from '../../components/TarjetaInvestigacion.astro';

const ORCID = '0009-0004-2313-8173';

// Se juntan los trabajos escritos a mano y los importados de ORCID. Si un DOI
// aparece en ambos, gana la ficha escrita a mano, que lleva texto propio.
const manuales = await getCollection('investigacion');
const importados = await getCollection('publicaciones');

const doisManuales = new Set(
	manuales.map((e) => e.data.doi?.toLowerCase()).filter(Boolean),
);

const trabajos = [
	...manuales,
	...importados.filter((e) => !doisManuales.has(e.data.doi?.toLowerCase())),
].sort((a, b) => a.data.orden - b.data.orden || b.data.anio - a.data.anio);
---

<Base
	titulo="Investigación"
	descripcion="Publicaciones revisadas por pares, tesis y modelos computacionales en nanobiotecnología y biociencias."
>
	<h1 class="text-3xl font-bold tracking-tight text-tinta-900 dark:text-tinta-50">
		Investigación
	</h1>

	<p class="mt-3 leading-relaxed text-tinta-600 dark:text-tinta-400">
		Publicaciones revisadas por pares, tesis y modelos computacionales en
		nanobiotecnología, liberación controlada y sistemas basados en bacteriófagos.
	</p>

	<p class="mt-2 text-sm text-tinta-400">
		Las publicaciones se sincronizan desde
		<a
			href={`https://orcid.org/${ORCID}`}
			rel="noopener"
			target="_blank"
			class="text-acento-500 hover:underline">ORCID {ORCID}</a
		>.
	</p>

	<div class="mt-8 grid gap-4">
		{trabajos.map((entrada) => <TarjetaInvestigacion entrada={entrada} />)}
	</div>

	{
		trabajos.length === 0 && (
			<p class="mt-8 text-tinta-400">Todavía no hay trabajos publicados.</p>
		)
	}
</Base>
